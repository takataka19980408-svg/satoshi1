{
  "dream_event": {
    "condition": { "flagSet": "tower_top_seen", "flagNotSet": "dream_seen" },
    "steps": [
      { "type": "setFlag", "flag": "dream_seen" },
      { "type": "blackout", "duration": 1500 },
      { "type": "narration", "lines": ["眠れなかった。", "夢なのか、現実なのか——"], "duration": 3500 },
      { "type": "wait", "duration": 800 },
      { "type": "narration", "lines": ["どこかに、遠い影があった。"], "duration": 2500 },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "アステラ——", "speaker": "サトシ" },
      { "type": "wait", "duration": 1000 },
      { "type": "dialog", "text": "......", "speaker": "" },
      { "type": "wait", "duration": 800 },
      { "type": "dialog", "text": "その名前を……\n知っているの？", "speaker": "???" },
      { "type": "wait", "duration": 600 },
      { "type": "clearBlackout", "duration": 2000 },
      { "type": "end" }
    ]
  },
  "zect_ambush": {
    "condition": { "flagSet": "astera_truth_seen", "flagNotSet": "zect_met" },
    "steps": [
      { "type": "setFlag", "flag": "zect_met" },
      { "type": "wait", "duration": 400 },
      { "type": "shake", "duration": 500, "intensity": 4 },
      { "type": "sfx", "id": "damage" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "（大通りに、黒いマントの男が\n立っていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "久しぶりだな、リル。\n相変わらず、面倒な側にいる。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "（リルの動きが、止まった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "...あなた、誰？\nあたしのこと、知ってるの？", "speaker": "リル" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（男は答えず、石に目を向けた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "アステラか。\nまだ眠ったままだな。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "どうして名前を知ってる！", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "我々は長い間、あの星の欠片を\n探してきた。\n黒曜団の目的のためにな。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "黒曜団の目的？", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "星の力を、この世界に取り戻す。\nアステラはそのための鍵だ。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（男は石を見つめ続けた。\n怒りではなく、焦りのある目で）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "それより——\nお前は何者だ。\nなぜ星の民の血を引く者が\n今頃、現れる。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（サトシは、言葉を失った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "星の民...？", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（男は少し驚いたような顔をした。\nそして、薄く笑った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "知らないのか。\nならば——まだ時間がある。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（男が振り向いた。\n去り際に、リルの方を見た）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "リル。\nもうすぐ思い出す。\nお前が、何者だったか。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（男が、消えた）", "speaker": "" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（リルは、動かなかった。\n顔が、青白かった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "...リル？", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "平気。\nただ——なんで、怖いんだろ。\nあいつの顔、知らないのに。", "speaker": "リル" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（石が、かすかに震えていた）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },
  "eldo_chapter4": {
    "condition": { "flagSet": ["eldo_met", "zect_met"], "flagNotSet": "eldo_chapter4_seen" },
    "steps": [
      { "type": "setFlag", "flag": "eldo_chapter4_seen" },
      { "type": "npcFace", "npcId": "eldo", "dir": "down" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "アステラって——\n誰なんだ。", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（エルドが、目を見開いた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "...その名を、\nどこで聞いた。", "speaker": "エルド" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "石が——\n話しかけてきた。", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（エルドは、しばらく黙っていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 800 },
      { "type": "dialog", "text": "ならば——\n私に聞くな。", "speaker": "エルド" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "アステラに、聞いてみろ。", "speaker": "エルド" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "どうやって——？", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "夜を待て。", "speaker": "エルド" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（エルドは、それ以上何も言わなかった）", "speaker": "サトシ" },

      { "type": "save" },
      { "type": "wait", "duration": 800 },
      { "type": "blackout", "duration": 1000 },
      { "type": "narration", "lines": ["夜になった。"], "duration": 2000 },
      { "type": "glow", "color": "#aaddff", "duration": 8000 },
      { "type": "narration", "lines": ["石が、青白く光り始めた。"], "duration": 2500 },
      { "type": "dialog", "text": "（モフが、目を覚ました）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（リルの様子が、変わった。\n立ち上がって——遠くを見ていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "...来て。", "speaker": "アステラ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（初めて——\nアステラ自身が、呼びかけてきた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },

      { "type": "narration", "lines": ["サトシは、外へ出た。"], "duration": 2000 },
      { "type": "narration", "lines": ["空を見上げると——", "星の並びが、変わっていた。"], "duration": 3000 },
      { "type": "narration", "lines": ["普段より、星が明るかった。"], "duration": 2500 },
      { "type": "dialog", "text": "始まった...", "speaker": "リル" },
      { "type": "wait", "duration": 600 },

      { "type": "bgm", "id": "boss" },
      { "type": "shake", "duration": 800, "intensity": 8 },
      { "type": "wait", "duration": 300 },
      { "type": "narration", "lines": ["空が、揺れた。"], "duration": 2000 },
      { "type": "flash", "color": "#aaddff", "duration": 400 },
      { "type": "wait", "duration": 300 },
      { "type": "narration", "lines": ["雲が、裂けた。"], "duration": 1800 },
      { "type": "wait", "duration": 400 },
      { "type": "shake", "duration": 600, "intensity": 6 },
      { "type": "narration", "lines": ["巨大な光の柱が——", "空に伸びた。"], "duration": 3000 },
      { "type": "wait", "duration": 600 },
      { "type": "flash", "color": "#ffffff", "duration": 700 },
      { "type": "narration", "lines": ["そして——"], "duration": 1500 },
      { "type": "narration", "lines": ["空中に、巨大な遺跡が浮かんだ。"], "duration": 3000 },
      { "type": "narration", "lines": ["星の神殿。"], "duration": 2500 },

      { "type": "dialog", "text": "呼ばれたか。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（影から、ゼクトが現れた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "何が——起きている。", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "アステラが、お前を選んだ。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "選んだ——？", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "真実を知りたければ、行け。", "speaker": "ゼクト" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（ゼクトが、消えた）", "speaker": "サトシ" },

      { "type": "wait", "duration": 500 },
      { "type": "glow", "color": "#aaddff", "duration": 6000 },
      { "type": "dialog", "text": "（ペンダントが、光り始めた。\n石も、同じ色で応えた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（空へ続く——光の道が、見えた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "行こう。", "speaker": "リル" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "（モフが、鼻を鳴らした）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "narration", "lines": ["三人は、", "光の道を歩き始めた。"], "duration": 3000 },

      { "type": "teleport", "toMap": "star_bridge", "toX": 3, "toY": 12 },
      { "type": "clearBlackout", "duration": 1500 },
      { "type": "end" }
    ]
  }
}
