{
  "house_start": {
    "steps": [
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "静かな朝。\n外から、鳥の声が聞こえる。", "speaker": "" },
      { "type": "dialog", "text": "今日も、いつもと変わらない日だと\nサトシは思っていた。", "speaker": "" },
      { "type": "bgm", "id": "village" },
      { "type": "end" }
    ]
  },
  "forest_enter": {
    "condition": { "flagNotSet": "forest_entered" },
    "steps": [
      { "type": "setFlag", "flag": "forest_entered" },
      { "type": "bgm", "id": "forest" },
      { "type": "dialog", "text": "ささやきの森。\n昼でも、少し暗い。", "speaker": "" },
      { "type": "dialog", "text": "（足元の草が、風もないのに揺れている）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },
  "mofu_encounter": {
    "condition": { "flagNotSet": "mofu_joined" },
    "steps": [
      { "type": "sfx", "id": "stone" },
      { "type": "dialog", "text": "茂みから、小さな鳴き声が聞こえた。", "speaker": "" },
      { "type": "dialog", "text": "白い毛をした、犬のような小さな獣。\n怯えているのに、目だけはじっとこちらを見ている。", "speaker": "" },
      { "type": "dialog", "text": "（逃げない。怖がっているはずなのに）", "speaker": "サトシ" },
      { "type": "dialog", "text": "しゃがんで手を差し出すと、\n獣はゆっくりと近づいてきた。", "speaker": "" },
      { "type": "dialog", "text": "...", "speaker": "モフ" },
      { "type": "addMonster", "monsterId": "mofu" },
      { "type": "setFlag", "flag": "mofu_joined" },
      { "type": "dialog", "text": "モフが仲間になった。", "speaker": "" },
      { "type": "end" }
    ]
  },
  "stone_discovery": {
    "condition": { "flagNotSet": "stone_found" },
    "steps": [
      { "type": "dialog", "text": "足元に、光るものがある。", "speaker": "" },
      { "type": "dialog", "text": "草の間に、青白く光る石が落ちていた。", "speaker": "" },
      { "type": "dialog", "text": "拾ってみる？", "choices": [
        { "label": "はい", "goto": "pick_yes" },
        { "label": "いいえ", "goto": "pick_no" }
      ]},
      { "type": "label", "id": "pick_no" },
      { "type": "dialog", "text": "（でも、なぜか視線が離せない）", "speaker": "サトシ" },
      { "type": "dialog", "text": "拾ってみる？", "choices": [
        { "label": "はい", "goto": "pick_yes" },
        { "label": "やっぱりいいや", "goto": "pick_cancel" }
      ]},
      { "type": "label", "id": "pick_cancel" },
      { "type": "dialog", "text": "（それでも、その石から目が離せなかった）", "speaker": "サトシ" },
      { "type": "label", "id": "pick_yes" },
      { "type": "sfx", "id": "stone" },
      { "type": "flash", "color": "#aaddff", "duration": 400 },
      { "type": "dialog", "text": "石に触れた瞬間。", "speaker": "" },
      { "type": "dialog", "text": "返して。", "speaker": "???" },
      { "type": "dialog", "text": "（声が、頭の中に直接響いた）", "speaker": "サトシ" },
      { "type": "dialog", "text": "（外から聞こえた声じゃない。\nまるで、頭の中から）", "speaker": "サトシ" },
      { "type": "addItem", "itemId": "strange_stone" },
      { "type": "setFlag", "flag": "stone_found" },
      { "type": "dialog", "text": "奇妙な石を手に入れた。", "speaker": "" },
      { "type": "end" }
    ]
  },
  "boss_trigger": {
    "condition": { "flagNotSet": "boss_defeated" },
    "steps": [
      { "type": "dialog", "text": "地面が震えた。", "speaker": "" },
      { "type": "sfx", "id": "damage" },
      { "type": "dialog", "text": "森の奥から、大きな影が近づいてくる。", "speaker": "" },
      { "type": "dialog", "text": "プニキング。\n本来は、森の静かな守り主のはずの生き物。", "speaker": "" },
      { "type": "dialog", "text": "その目に、理性はない。", "speaker": "" },
      { "type": "bgm", "id": "boss" },
      { "type": "battle", "enemyId": "puni_king", "isBoss": true, "onWin": "boss_win" }
    ]
  },
  "boss_win": {
    "steps": [
      { "type": "bgm", "id": "forest" },
      { "type": "flash", "color": "#aaddff", "duration": 600 },
      { "type": "dialog", "text": "プニキングが静かになった。", "speaker": "" },
      { "type": "dialog", "text": "石が、一瞬強く光った。", "speaker": "" },
      { "type": "dialog", "text": "（また声がした。さっきよりも、小さく）", "speaker": "サトシ" },
      { "type": "dialog", "text": "...ごめん。", "speaker": "???" },
      { "type": "dialog", "text": "（何に謝っているのか、わからない）", "speaker": "サトシ" },
      { "type": "setFlag", "flag": "boss_defeated" },
      { "type": "dialog", "text": "ミドリ村に戻ろう。", "speaker": "" },
      { "type": "teleport", "toMap": "midori_village", "toX": 9, "toY": 14 },
      { "type": "end" }
    ]
  },
  "chapter1_end": {
    "condition": { "flagSet": "boss_defeated", "flagNotSet": "chapter1_ended" },
    "steps": [
      { "type": "dialog", "text": "村長のもとへ向かった。", "speaker": "" },
      { "type": "dialog", "text": "サトシか。よく戻った。\n森の騒ぎは収まったようだな。", "speaker": "村長" },
      { "type": "dialog", "text": "その石を持っているうちは、\nまた何か起きるかもしれん。", "speaker": "村長" },
      { "type": "dialog", "text": "お前に頼みがある。\n王都へ行ってくれ。", "speaker": "村長" },
      { "type": "dialog", "text": "賢者エルドに会いなさい。\nあの方なら、何かわかるはずだ。", "speaker": "村長" },
      { "type": "dialog", "text": "（サトシは石を見つめた。\nまだ光っている）", "speaker": "サトシ" },
      { "type": "dialog", "text": "（声は、もう聞こえない。\nでも、何かがそこにある気がした）", "speaker": "サトシ" },
      { "type": "setFlag", "flag": "chapter1_ended" },
      { "type": "bgm", "id": "ending" },
      { "type": "save" },
      { "type": "endChapter" }
    ]
  }
}
