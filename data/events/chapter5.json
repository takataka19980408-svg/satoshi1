{
  "astera_appear": {
    "condition": { "flagSet": ["underground_cleared", "tower_top_seen"], "flagNotSet": "astera_appear_seen" },
    "steps": [
      { "type": "setFlag", "flag": "astera_appear_seen" },
      { "type": "wait", "duration": 400 },
      { "type": "flash", "color": "#aaddff", "duration": 400 },
      { "type": "glow", "color": "#aaddff", "duration": 5000 },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（石が、急に熱くなった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "...来て。\nもっと近い場所がある。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（石の光が、塔の壁を\nすり抜けていく）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "ついてきて！", "speaker": "リル" },
      { "type": "blackout", "duration": 1000 },
      { "type": "narration", "lines": ["光に引かれて、", "二人は扉のない場所へ踏み込んだ。"], "duration": 3000 },
      { "type": "teleport", "toMap": "star_temple", "toX": 6, "toY": 10 },
      { "type": "clearBlackout", "duration": 1500 },
      { "type": "end" }
    ]
  },
  "temple_enter": {
    "condition": { "flagNotSet": "temple_entered" },
    "steps": [
      { "type": "setFlag", "flag": "temple_entered" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "星の神殿。\n光だけで作られた、扉のない場所。", "speaker": "" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（空気が違う。\n地面も、壁も、すべてが\n柔らかく光っている）", "speaker": "サトシ" },
      { "type": "dialog", "text": "ここが——アステラの、\n本当の場所？", "speaker": "リル" },
      { "type": "wait", "duration": 400 },
      { "type": "glow", "color": "#aaddff", "duration": 6000 },
      { "type": "end" }
    ]
  },
  "astera_materialize": {
    "condition": { "flagSet": "temple_entered", "flagNotSet": "astera_materialize_seen" },
    "steps": [
      { "type": "setFlag", "flag": "astera_materialize_seen" },
      { "type": "wait", "duration": 500 },
      { "type": "flash", "color": "#aaddff", "duration": 500 },
      { "type": "glow", "color": "#aaddff", "duration": 8000 },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（光の中に、形が現れた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（小さな子どもの姿。\n髪も、瞳も、すべてが光でできている）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "お前が...アステラ？", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "うん。\nずっと、声だけだったから。\nこうして出てくるのは、初めて。", "speaker": "アステラ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（リルが、前に出た）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "アステラ——\nあたしのこと、知ってる？", "speaker": "リル" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "知ってる。\nずっと、一緒にいたから。\n生まれた時から。", "speaker": "アステラ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（サトシは、二人を見ていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "消えることと、終わることは\n違うんだ。\nそれを教えてくれたのは、\nリルだよ。", "speaker": "アステラ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（塔の頂で、アステラが言っていた。\n「死にたいんだ」——\nあの言葉が、変わっていく）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },
  "ril_truth": {
    "condition": { "flagSet": "astera_materialize_seen", "flagNotSet": "ril_truth_seen" },
    "steps": [
      { "type": "setFlag", "flag": "ril_truth_seen" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "アステラ、聞いていいか。\nリルの記憶を封じたのは、\nお前なのか？", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "うん。\nリルが守護者として生まれたら、\n自分の役割を知って——\n怖くなると思ったから。", "speaker": "アステラ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（リルが、目を細めた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "守護者って——\nあたしは、何をするの。", "speaker": "リル" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "私が消える時——\n残った光を、受け取る人。\n次の星の時代が来るまで、\n守っていてくれる人。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（長い沈黙があった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "...それ、怖くない。\nむしろ——\nずっと、そんな気がしてた。", "speaker": "リル" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラが、少し笑った）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },
  "final_decision": {
    "condition": { "flagSet": "ril_truth_seen", "flagNotSet": "game_cleared" },
    "steps": [
      { "type": "setFlag", "flag": "game_cleared" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "アステラ——\n準備ができたら、教えてくれ。\nお前の思う通りにしていい。", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "...うん。\nじゃあ——今。", "speaker": "アステラ" },
      { "type": "wait", "duration": 800 },
      { "type": "flash", "color": "#aaddff", "duration": 600 },
      { "type": "glow", "color": "#ffffff", "duration": 5000 },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（光が、溢れた。\n眩しくて、目が開けていられない）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（リルが、両手を広げた。\n光を受けるように）", "speaker": "サトシ" },
      { "type": "blackout", "duration": 1200 },
      { "type": "narration", "lines": ["光が消えた。", "神殿も、消えた。"], "duration": 3500 },
      { "type": "save" },
      { "type": "wait", "duration": 500 },
      { "type": "narration", "lines": ["残ったのは、", "夜の空気と、二人と、", "サトシの手の中の、石だった。"], "duration": 4000 },
      { "type": "wait", "duration": 1000 },
      { "type": "clearBlackout", "duration": 2000 },
      { "type": "dialog", "text": "（石が、もう光っていない）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（重さは変わらない。\nでも、何かが——終わった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "...ね。", "speaker": "リル" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "ん？", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "傭兵、続けてもいいかな。\nあたしの旅。", "speaker": "リル" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（サトシは、少し考えた。\nそして、笑った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "俺も続けるよ。\n同じ方向だし。", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "blackout", "duration": 1000 },
      { "type": "narration", "lines": ["おわり"], "duration": 2000 },
      { "type": "wait", "duration": 500 },
      { "type": "narration", "lines": ["おわり", "", "——石の中に、", "まだ何かが、残っている。"], "duration": 4500 },
      { "type": "wait", "duration": 1500 },
      { "type": "teleport", "toMap": "midori_village", "toX": 9, "toY": 16 },
      { "type": "bgm", "id": "village" },
      { "type": "clearBlackout", "duration": 2000 },
      { "type": "end" }
    ]
  }
}
