{
  "astera_appear": {
    "condition": { "flagSet": ["underground_cleared", "tower_top_seen"], "flagNotSet": "astera_appear_seen" },
    "steps": [
      { "type": "setFlag", "flag": "astera_appear_seen" },
      { "type": "wait", "duration": 400 },
      { "type": "flash", "color": "#aaddff", "duration": 400 },
      { "type": "glow", "color": "#aaddff", "duration": 5000 },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（石が、急に熱くなった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "...来て。\nもっと近い場所がある。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（石の光が、塔の壁を\nすり抜けていく）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "ついてきて！", "speaker": "リル" },
      { "type": "blackout", "duration": 1000 },
      { "type": "narration", "lines": ["光に引かれて、", "二人は扉のない場所へ踏み込んだ。"], "duration": 3000 },
      { "type": "teleport", "toMap": "star_temple", "toX": 6, "toY": 10 },
      { "type": "clearBlackout", "duration": 1500 },
      { "type": "end" }
    ]
  },
  "temple_enter": {
    "condition": { "flagNotSet": "temple_entered" },
    "steps": [
      { "type": "setFlag", "flag": "temple_entered" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "星の神殿。\n光だけで作られた、扉のない場所。", "speaker": "" },
      { "type": "wait", "duration": 400 },
      { "type": "glow", "color": "#aaddff", "duration": 6000 },
      { "type": "dialog", "text": "（壁に、星の文明の記憶が映っている。\n見たことのない都市。\n空へ伸びる光の柱。\nそして——消えていく民の姿）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "ここは——アステラの、\n記憶の場所？", "speaker": "リル" },
      { "type": "wait", "duration": 400 },
      { "type": "end" }
    ]
  },
  "astera_memories": {
    "condition": { "flagSet": "temple_entered", "flagNotSet": "astera_memories_seen" },
    "steps": [
      { "type": "setFlag", "flag": "astera_memories_seen" },
      { "type": "wait", "duration": 500 },
      { "type": "flash", "color": "#aaddff", "duration": 500 },
      { "type": "glow", "color": "#aaddff", "duration": 8000 },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（光の中に、形が現れた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（小さな子どもの姿。\n髪も、瞳も、すべてが光でできている）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "...来てくれた。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "アステラ——\nお前が、石の中にいたのか。", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "ずっと。\n千年、ずっと。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（周りの壁に、映像が流れた。\n星の文明。\nそして、滅びの瞬間）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "あたしたちは、消えることを選んだ。\nこの世界の時間を、止めたくなかったから。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "でも——\nあたしだけが、残った。\n終われなかった。", "speaker": "アステラ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（石が、静かに光っていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "だから、俺を選んだのか。\n終わるために。", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（アステラは、答えなかった。\nただ——笑った）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },
  "ril_disappears": {
    "condition": { "flagSet": "astera_memories_seen", "flagNotSet": "ril_gone" },
    "steps": [
      { "type": "setFlag", "flag": "ril_gone" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（リルが、前に出た）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "アステラを責めないで。", "speaker": "リル" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "あの子は悪い子じゃない。\nただ——\nずっと、一人だっただけ。", "speaker": "リル" },
      { "type": "wait", "duration": 600 },
      { "type": "glow", "color": "#aaddff", "duration": 6000 },
      { "type": "dialog", "text": "（リルの体が、青白い光を帯び始めた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "リル——？", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "あたしは、アステラの記憶から\n生まれた存在。\n守護者の形を借りた——影。", "speaker": "リル" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "本物の守護者が現れるまで、\nアステラの側に居続けるために。", "speaker": "リル" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "...サトシ。\n来てくれてよかった。", "speaker": "リル" },
      { "type": "wait", "duration": 700 },
      { "type": "flash", "color": "#aaddff", "duration": 800 },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（光が、溢れた）", "speaker": "" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（リルが、消えた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 800 },
      { "type": "removeMonster", "monsterId": "ril" },
      { "type": "end" }
    ]
  },
  "astera_boss": {
    "condition": { "flagSet": "ril_gone", "flagNotSet": "astera_boss_started" },
    "steps": [
      { "type": "setFlag", "flag": "astera_boss_started" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラが、サトシの前に立った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "お前の覚悟を、見せて。\n本当に——終わらせてくれるなら。", "speaker": "アステラ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（石が、強く光った。\nアステラの輪郭が、揺れた）", "speaker": "サトシ" },
      { "type": "bgm", "id": "boss" },
      { "type": "battle", "enemyId": "astera_form", "isBoss": true, "onWin": "astera_boss_win" }
    ]
  },
  "astera_boss_win": {
    "steps": [
      { "type": "setFlag", "flag": "astera_boss_defeated" },
      { "type": "bgm", "id": "forest" },
      { "type": "wait", "duration": 600 },
      { "type": "flash", "color": "#aaddff", "duration": 600 },
      { "type": "glow", "color": "#aaddff", "duration": 5000 },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラの光が、静まった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（疲れたような表情で、\n小さな子どもの姿に戻った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "...合格。", "speaker": "アステラ" },
      { "type": "end" }
    ]
  },
  "final_decision": {
    "condition": { "flagSet": "astera_boss_defeated", "flagNotSet": "game_cleared" },
    "steps": [
      { "type": "setFlag", "flag": "game_cleared" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "アステラ——\n準備ができたら、教えてくれ。", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラは、長い間、\n空を見上げていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "ねえ、サトシ。\n選んでいい？", "speaker": "アステラ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "うん。", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "どうする？", "speaker": "アステラ", "choices": [
        { "label": "終わらせる", "goto": "end_astera" },
        { "label": "一緒に生きる", "goto": "live_together" }
      ]},

      { "type": "label", "id": "end_astera" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラが、目を閉じた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "ありがとう。\nずっと——待ってたんだ。", "speaker": "アステラ" },
      { "type": "wait", "duration": 800 },
      { "type": "flash", "color": "#aaddff", "duration": 600 },
      { "type": "glow", "color": "#ffffff", "duration": 5000 },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（光が、溢れた）", "speaker": "" },
      { "type": "blackout", "duration": 1200 },
      { "type": "narration", "lines": ["光が消えた。", "神殿も、消えた。"], "duration": 3500 },
      { "type": "wait", "duration": 500 },
      { "type": "narration", "lines": ["夜空から、ひとつの星が", "静かに消えた。"], "duration": 3500 },
      { "type": "save" },
      { "type": "wait", "duration": 1000 },
      { "type": "narration", "lines": ["残ったのは——", "夜の空気と、", "サトシの手の中の、冷たい石だった。"], "duration": 4000 },
      { "type": "wait", "duration": 1000 },
      { "type": "narration", "lines": ["おわり"], "duration": 2000 },
      { "type": "wait", "duration": 800 },
      { "type": "narration", "lines": ["——そのとき、", "空から、何かが落ちてきた。"], "duration": 3000 },
      { "type": "wait", "duration": 800 },
      { "type": "dialog", "text": "（サトシは、空を見上げた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "また、奇妙なものが来たね。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（声がした。\nどこからか——\n石の中から）", "speaker": "サトシ" },
      { "type": "wait", "duration": 800 },
      { "type": "teleport", "toMap": "midori_village", "toX": 9, "toY": 16 },
      { "type": "bgm", "id": "village" },
      { "type": "clearBlackout", "duration": 2000 },
      { "type": "end" },

      { "type": "label", "id": "live_together" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（サトシは、石を握った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "終わらせない。\nお前と、一緒にいる。", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（アステラが、長い間、黙っていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "...でも、あたしは\nずっとここにいるよ。\nサトシが死んでも。", "speaker": "アステラ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "知ってる。\nそれでも、一緒がいい。", "speaker": "サトシ" },
      { "type": "wait", "duration": 800 },
      { "type": "glow", "color": "#aaddff", "duration": 6000 },
      { "type": "dialog", "text": "（石が、温かく光った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（アステラは、また笑った。\n今度は——少し、違う笑い方で）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "じゃあ——\n新しい意味を、一緒に見つけよう。\nあたしにとっての。", "speaker": "アステラ" },
      { "type": "wait", "duration": 700 },
      { "type": "blackout", "duration": 1000 },
      { "type": "narration", "lines": ["おわり"], "duration": 2000 },
      { "type": "wait", "duration": 800 },
      { "type": "narration", "lines": ["——そのとき、", "空から、何かが落ちてきた。"], "duration": 3000 },
      { "type": "wait", "duration": 800 },
      { "type": "dialog", "text": "（サトシは、空を見上げた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "また、奇妙なものが来たね。", "speaker": "アステラ" },
      { "type": "wait", "duration": 800 },
      { "type": "save" },
      { "type": "teleport", "toMap": "midori_village", "toX": 9, "toY": 16 },
      { "type": "bgm", "id": "village" },
      { "type": "clearBlackout", "duration": 2000 },
      { "type": "end" }
    ]
  }
}
