{
  "bridge_walk1": {
    "condition": { "flagNotSet": "bridge_walk1_seen" },
    "steps": [
      { "type": "setFlag", "flag": "bridge_walk1_seen" },
      { "type": "wait", "duration": 400 },
      { "type": "glow", "color": "#aaddff", "duration": 6000 },
      { "type": "dialog", "text": "（石が、青白く光り続けていた。\nその光が、道を照らしていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "あそこだ。", "speaker": "リル" },
      { "type": "end" }
    ]
  },

  "bridge_walk2": {
    "condition": { "flagNotSet": "bridge_walk2_seen" },
    "steps": [
      { "type": "setFlag", "flag": "bridge_walk2_seen" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（石が、温かかった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "...待っててくれたんだな。", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（石は、答えなかった。\nただ——光り続けた）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },

  "bridge_walk3": {
    "condition": { "flagNotSet": "bridge_walk3_seen" },
    "steps": [
      { "type": "setFlag", "flag": "bridge_walk3_seen" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（巨大な遺跡が、目の前に広がった。\n星の光で作られた、見たことのない場所）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "ここが——星の民の。", "speaker": "リル" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（サトシは、石を握った）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },

  "temple_enter": {
    "condition": { "flagNotSet": "temple_entered" },
    "steps": [
      { "type": "setFlag", "flag": "temple_entered" },
      { "type": "wait", "duration": 600 },
      { "type": "bgm", "id": "forest" },
      { "type": "glow", "color": "#aaddff", "duration": 8000 },
      { "type": "dialog", "text": "星の神殿。\n光だけで作られた、静かな場所。", "speaker": "" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（壁に、光の記憶が映っていた。\n空に浮かぶ都市。光の柱。\nそして——消えていく、人々の姿）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "ここが——アステラの、\n記憶の場所？", "speaker": "リル" },
      { "type": "end" }
    ]
  },

  "astera_memories": {
    "condition": { "flagSet": "temple_entered", "flagNotSet": "astera_memories_seen" },
    "steps": [
      { "type": "setFlag", "flag": "astera_memories_seen" },
      { "type": "wait", "duration": 500 },
      { "type": "flash", "color": "#aaddff", "duration": 400 },
      { "type": "glow", "color": "#aaddff", "duration": 10000 },
      { "type": "dialog", "text": "（光の中に、映像が浮かんだ）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（空中に浮かぶ都市。\n星の光で織られた建物。\n人々が笑っていた。\nずっと、笑っていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（しかし——時が止まったように、\n同じ顔が続いた。\n百年。千年。\n笑いが、薄くなっていった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（そして、静かに——\n一人ずつ、消えていった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "自ら、消えることを——\n選んだのか。", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "やっと来た。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（光が集まり——\n小さな子どもの形になった。\n髪も瞳も、すべてが星の光でできていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "アステラ——\nお前が、石の中に。", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "千年。\nずっと、ここにいた。", "speaker": "アステラ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（アステラは、遠くを見た）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "死ねなくなったんだ。\n長すぎて——\nあたしたちは、自ら消えることを選んだ。\nあたし以外は、みんな。", "speaker": "アステラ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "だからあたしは——\n帰りたいんじゃない。\n死にたいんだ。", "speaker": "アステラ" },
      { "type": "wait", "duration": 800 },
      { "type": "dialog", "text": "（石が、静かに光っていた）", "speaker": "サトシ" },
      { "type": "end" }
    ]
  },

  "ril_disappears": {
    "condition": { "flagSet": "astera_memories_seen", "flagNotSet": "ril_gone" },
    "steps": [
      { "type": "setFlag", "flag": "ril_gone" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（リルが、前に出た）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "本当はね。", "speaker": "リル" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "最初から——\n死んでたの。", "speaker": "リル" },
      { "type": "wait", "duration": 600 },
      { "type": "glow", "color": "#aaddff", "duration": 7000 },
      { "type": "dialog", "text": "（リルの体が、\n青白い光を帯び始めた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "リル——？", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "アステラの記憶から生まれた。\n孤独が——形になった存在。\n誰かが来るまで、一緒にいるために。", "speaker": "リル" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "来てくれてよかった。", "speaker": "リル" },
      { "type": "wait", "duration": 800 },
      { "type": "flash", "color": "#aaddff", "duration": 800 },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（リルが、消えた）", "speaker": "" },
      { "type": "wait", "duration": 800 },
      { "type": "removeMonster", "monsterId": "ril" },
      { "type": "end" }
    ]
  },

  "astera_boss": {
    "condition": { "flagSet": "ril_gone", "flagNotSet": "astera_boss_started" },
    "steps": [
      { "type": "setFlag", "flag": "astera_boss_started" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラが、サトシの前に立った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "あなたは——\n何を選ぶの？", "speaker": "アステラ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（石が、強く光った。\nアステラの輪郭が、揺れた）", "speaker": "サトシ" },
      { "type": "bgm", "id": "boss" },
      { "type": "battle", "enemyId": "astera_form", "isBoss": true, "onWin": "astera_boss_win" }
    ]
  },

  "astera_boss_win": {
    "steps": [
      { "type": "setFlag", "flag": "astera_boss_defeated" },
      { "type": "bgm", "id": "forest" },
      { "type": "wait", "duration": 600 },
      { "type": "flash", "color": "#aaddff", "duration": 500 },
      { "type": "glow", "color": "#aaddff", "duration": 5000 },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（光が、静まった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラが、\n小さな子どもの姿に戻っていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "私は——\nどうすればいい？", "speaker": "アステラ" },
      { "type": "end" }
    ]
  },

  "final_decision": {
    "condition": { "flagSet": "astera_boss_defeated", "flagNotSet": "game_cleared" },
    "steps": [
      { "type": "setFlag", "flag": "game_cleared" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "（アステラが、サトシを見ていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 300 },
      { "type": "dialog", "text": "あなたが、決めて。", "speaker": "アステラ", "choices": [
        { "label": "終わらせる", "goto": "end_astera" },
        { "label": "一緒に生きる", "goto": "live_together" }
      ]},

      { "type": "label", "id": "end_astera" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（アステラが、目を閉じた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "ありがとう。\nずっと——待ってたんだ。", "speaker": "アステラ" },
      { "type": "wait", "duration": 800 },
      { "type": "flash", "color": "#aaddff", "duration": 600 },
      { "type": "glow", "color": "#ffffff", "duration": 5000 },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（光が、溢れた）", "speaker": "" },
      { "type": "blackout", "duration": 1200 },
      { "type": "narration", "lines": ["光が消えた。", "神殿も、消えた。"], "duration": 3500 },
      { "type": "narration", "lines": ["夜空から、ひとつの星が", "静かに消えた。"], "duration": 3500 },
      { "type": "narration", "lines": ["数年後——"], "duration": 2000 },
      { "type": "narration", "lines": ["サトシは、まだ旅をしていた。", "モフと一緒に。"], "duration": 3500 },
      { "type": "narration", "lines": ["ある夜、空を見上げると——", "流れ星が、落ちた。"], "duration": 3500 },
      { "type": "narration", "lines": ["「また、奇妙なものが来たね」"], "duration": 3000 },
      { "type": "narration", "lines": ["声がした。", "石の中から。"], "duration": 3000 },
      { "type": "save" },
      { "type": "narration", "lines": ["サトシと奇妙な石", "　　　　　完"], "duration": 5000 },
      { "type": "wait", "duration": 1000 },
      { "type": "teleport", "toMap": "midori_village", "toX": 9, "toY": 16 },
      { "type": "bgm", "id": "village" },
      { "type": "clearBlackout", "duration": 2000 },
      { "type": "end" },

      { "type": "label", "id": "live_together" },
      { "type": "wait", "duration": 500 },
      { "type": "dialog", "text": "（サトシは、石を握った）", "speaker": "サトシ" },
      { "type": "wait", "duration": 400 },
      { "type": "dialog", "text": "探そう。\n生きる理由。", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "dialog", "text": "（アステラは、長い間、\nサトシを見ていた）", "speaker": "サトシ" },
      { "type": "wait", "duration": 700 },
      { "type": "dialog", "text": "（そして——泣いた。\n音もなく、ただ光の粒が落ちていった）", "speaker": "サトシ" },
      { "type": "wait", "duration": 800 },
      { "type": "glow", "color": "#aaddff", "duration": 6000 },
      { "type": "dialog", "text": "（二人は、歩き出した）", "speaker": "サトシ" },
      { "type": "wait", "duration": 600 },
      { "type": "blackout", "duration": 1000 },
      { "type": "narration", "lines": ["数年後——"], "duration": 2000 },
      { "type": "narration", "lines": ["サトシは、まだ旅をしていた。", "モフと一緒に。"], "duration": 3500 },
      { "type": "narration", "lines": ["ある夜、空を見上げると——", "流れ星が、落ちた。"], "duration": 3500 },
      { "type": "narration", "lines": ["「また、奇妙なものが来たね」"], "duration": 3000 },
      { "type": "narration", "lines": ["声がした。", "隣から——石の中から。"], "duration": 3000 },
      { "type": "save" },
      { "type": "narration", "lines": ["サトシと奇妙な石", "　　　　　完"], "duration": 5000 },
      { "type": "wait", "duration": 1000 },
      { "type": "teleport", "toMap": "midori_village", "toX": 9, "toY": 16 },
      { "type": "bgm", "id": "village" },
      { "type": "clearBlackout", "duration": 2000 },
      { "type": "end" }
    ]
  }
}
